{
  "id": "./",
  "name": "OrderPro",
  "short_name": "OrderPro",
  "description": "Suivi des commandes, acomptes, livraisons et bilans.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#013c2c",
  "theme_color": "#013c2c",
  "lang": "fr",
  "shortcuts": [
    {
      "name": "Nouvelle commande",
      "short_name": "Nouvelle commande",
      "description": "Créer rapidement une commande OrderPro.",
      "url": "./?action=new-order",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Commandes",
      "short_name": "Commandes",
      "description": "Ouvrir la liste des commandes.",
      "url": "./?action=orders",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Clients",
      "short_name": "Clients",
      "description": "Ouvrir les fiches clients.",
      "url": "./?action=clients",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sauvegarde",
      "short_name": "Sauvegarde",
      "description": "Ouvrir la sauvegarde des données.",
      "url": "./?action=backup",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+orderpro",
      "url": "./?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./?file=%s",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
